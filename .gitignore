# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code local session lock (runtime-only, not project config)
.claude/scheduled_tasks.lock

# typescript
*.tsbuildinfo
next-env.d.ts

# 로컬 백업(마이그레이션 전 데이터 사본) — 커밋하지 않는다
.local-backups/

# 실제 수행평가 안내문 사진(학교·개인 정보 가능성) — 저장소에 올리지 않는다. 테스트는 로컬 경로에서 읽는다.
수행평가 안내문/

# 측정 산출물(실제 안내문 기반 결과물·분석 JSON이 들어간다)
scratchpad/
