# ── Gemini API (Google AI Studio에서 발급) ──────────────────────────
GEMINI_API_KEY=

# 모델 이름은 환경변수로 분리해서, 구글이 모델을 교체해도 코드 수정 없이 바꿀 수 있게 함.
# 2026-08-26 기준 공식 문서로 확인한 값 (개발 재개 시 다시 한번 확인 권장).
GEMINI_MODEL_FLASH_LITE=gemini-3.5-flash-lite
# gemini-3.7-flash가 원래 기획한 "핵심 생성" 모델이었지만, M1 실측 결과 (1) 현재
# 구글 서버 과부하로 불안정(429/503)하고 (2) 기본 thinking 예산이 커서 검색 그라운딩
# 포함 시 40~60초까지 걸려 N1/N2 목표를 크게 벗어남. gemini-3.5-flash-lite는 같은
# 조건에서 약 3초로 훨씬 빠르고 안정적이라 M1에서는 이 값으로 대체함.
# gemini-3.7-flash가 안정화되면 이 값만 바꿔서 다시 시도해볼 것.
GEMINI_MODEL_FLASH=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# 임베딩 벡터 차원. supabase/migrations의 vector(768)과 반드시 같은 값이어야 함.
GEMINI_EMBEDDING_DIMENSIONS=768

# ── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role 키는 절대 클라이언트로 보내지 말 것 (서버 전용, RLS 우회 권한)
SUPABASE_SERVICE_ROLE_KEY=

# ── 관리자 코드 로그인 (M7에서 사용) ──────────────────────────────────
ADMIN_LOGIN_CODE=

# ── Cloudflare Turnstile (비로그인 1회 생성 시 봇 방지, N4) ────────────
# 비워두면 개발 중에는 캡차 검증을 건너뛴다 (콘솔에 경고 로그만 남음).
# 배포 전에는 반드시 채울 것: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── 클러스터 매칭 임계값 (M2, N7: 배포 전 실제 샘플로 검증 후 조정) ───────
CLUSTER_MATCH_THRESHOLD=0.9
CLUSTER_AMBIGUOUS_FLOOR=0.8

# ── 비율 기반 억제 (M3, 6-2: 배포 전 실제 데이터로 검증 후 조정) ─────────
CLUSTER_SATURATION_WINDOW_MONTHS=3
CLUSTER_SATURATION_SIMILARITY=0.85
CLUSTER_SATURATION_SMOOTHING_K=25
CLUSTER_SATURATION_MILD_RATIO=0.3
CLUSTER_SATURATION_STRONG_RATIO=0.55

# ── 접근 제한 (M4, N3/11-3/11-5: 배포 전 목표 트래픽 대비 재계산) ────────
THROTTLE_GLOBAL_SOFT_LIMIT=500
THROTTLE_GLOBAL_HARD_MULTIPLIER=5
THROTTLE_LOGGED_IN_DAILY_LIMIT=2
THROTTLE_SOFT_DELAY_MS=3000

# --- 모델 제공자 (OpenAI 마이그레이션) ---
# openai | gemini (한 번에 하나만 — 파이프라인 안에서 섞지 않는다)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-5-mini
OPENAI_MODEL_LITE=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768
# 선택: OPENAI_SEARCH_CONTEXT_SIZE=low|medium|high, OPENAI_TIMEOUT_MS=55000
# 우선 처리(priority) 등급: 같은 모델이 약 3배 빠르지만 단가가 높다(기본 켜짐). 끄려면 default. 거절되면 자동으로 10분간 꺼진다.
# OPENAI_SERVICE_TIER=priority|default   OPENAI_PRIORITY_MULTIPLIER=1.8(비용 추정용 배율)
# 완성 원고 생성 경로: 기본은 조사→글쓰기 2단계(검색 필요한 비책 과제). legacy로 두면 예전 한 번 호출 경로만 쓴다.
# ESSAY_PIPELINE=legacy
# 책 과제(구절 요구 없음)의 빠른 경로(검색 없는 후보 제안 + 조사→글쓰기 + 서지를 페이지 본문으로 확인). legacy로 두면 예전 검색 기반 경로.
# ESSAY_BOOK_PIPELINE=legacy
# 조사 노트 재사용(기본 꺼짐): 같은 수행평가·같은 책/대상·같은 지침이면 앞선 학생의 조사 노트(공개 사실+근거 주소)를 쓴다. 다양성을 해칠 수 있어 측정 후에만 켠다. 유효기간 기본 14일.
# RESEARCH_CACHE=on   RESEARCH_CACHE_TTL_DAYS=14
# 임베딩 모델 교체 시각 — 이보다 오래된 결과물 임베딩은 겹침 방지 계산에서 제외한다
EMBEDDING_EPOCH=
